FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf-cache \
    CUDA_VISIBLE_DEVICES=""

# espeak-ng: German phonemizer backend. ffmpeg: MP3 encoding. git: German kokoro/misaki forks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    ffmpeg \
    libsndfile1 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch keeps the image small
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install -r requirements.txt

# German forks required by Thorsten-Voice/Kokoro (see model card)
RUN pip install \
    "git+https://github.com/semidark/misaki.git@6d252a2e02f3b030f22f56686f1a73786c16ffc8" \
    "git+https://github.com/semidark/kokoro.git"

# Weights before the code, so code changes reuse the cached download layer
RUN python -c "from huggingface_hub import hf_hub_download as d; [d('Thorsten-Voice/Kokoro', f) for f in ('config.json', 'model.pth', 'voices/thorsten.pt')]"

COPY textprep.py audioprep.py server.py ./

# Import loads and warms up the model once at build time
RUN python -c "import server; print('model prefetch ok')"

EXPOSE 8080

# One worker: the model is CPU bound and guarded by a lock. Threads let requests queue cheaply.
# Bind to [::] (dual stack): Railway private networking in this project is IPv6-only,
# so 0.0.0.0 would make the service unreachable from the backend.
CMD ["sh", "-c", "exec gunicorn --bind [::]:${PORT:-8080} --timeout 600 --workers 1 --threads 8 server:app"]
