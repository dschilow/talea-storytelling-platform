# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the bundle at
# build time, so only put publishable/public values here — never secrets.

# Clerk publishable key (Dashboard -> API Keys). Required.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend base URL. Optional — falls back to expo.extra.backendUrl in app.json.
# Android emulator reaching a local `encore run`: http://10.0.2.2:4000
EXPO_PUBLIC_BACKEND_URL=https://backend-2-production-3de1.up.railway.app
